{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/tanya-ok/ecs-contract/main/src/ecs_contract/schema/secrets.schema.json",
  "title": "ecs-contract secrets",
  "description": "Secrets the application owns, per environment. Every key names exactly one source. Becomes task definition secrets.",
  "type": "object",
  "required": ["environments"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "environments": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["secrets"],
        "additionalProperties": false,
        "properties": {
          "secrets": {
            "type": "object",
            "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
            "additionalProperties": { "$ref": "#/$defs/source" }
          }
        }
      }
    }
  },
  "$defs": {
    "source": {
      "oneOf": [
        { "$ref": "#/$defs/pointer" },
        { "$ref": "#/$defs/parameter" },
        { "$ref": "#/$defs/vault" }
      ]
    },
    "pointer": {
      "description": "A parameter whose value is the complete ARN of a secret another stack owns, plus an optional key inside it.",
      "type": "object",
      "required": ["pointer"],
      "additionalProperties": false,
      "properties": {
        "pointer": { "type": "string", "pattern": "^(/[A-Za-z0-9_.\\-]+)+$" },
        "jsonKey": { "type": "string", "minLength": 1 }
      }
    },
    "parameter": {
      "description": "A parameter read directly, for shared non-secret material.",
      "type": "object",
      "required": ["parameter"],
      "additionalProperties": false,
      "properties": {
        "parameter": { "type": "string", "pattern": "^/?[A-Za-z0-9_.\\-]+(/[A-Za-z0-9_.\\-]+)*$" }
      }
    },
    "vault": {
      "description": "A value fetched from an external secret store and written into the service's own config secret.",
      "type": "object",
      "required": ["vault"],
      "additionalProperties": false,
      "properties": {
        "vault": { "type": "string", "minLength": 1 }
      }
    }
  }
}
