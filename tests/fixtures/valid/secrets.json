{
  "$schema": "https://raw.githubusercontent.com/tanya-ok/ecs-contract/main/src/ecs_contract/schema/secrets.schema.json",
  "environments": {
    "development": {
      "secrets": {
        "DB_PASSWORD": { "pointer": "/orderbook/development/infra/db-secret-arn", "jsonKey": "password" },
        "TLS_CA_BUNDLE": { "parameter": "/shared/certs/bundle.pem" },
        "SETTLEMENT_API_TOKEN": { "vault": "orderbook-development/settlement-api/token" }
      }
    },
    "production": {
      "secrets": {
        "DB_PASSWORD": { "pointer": "/orderbook/production/infra/db-secret-arn", "jsonKey": "password" },
        "TLS_CA_BUNDLE": { "parameter": "/shared/certs/bundle.pem" },
        "SETTLEMENT_API_TOKEN": { "vault": "orderbook-production/settlement-api/token" }
      }
    }
  }
}
