{
  "environments": {
    "development": {
      "secrets": {
        "CACHE_URL": { "parameter": "/orderbook/development/cache-url" },
        "DB_PASSWORD": {},
        "QUEUE_TOKEN": { "pointer": "/orderbook/development/infra/queue-arn", "vault": "orderbook/queue-token" },
        "TLS_CA_BUNDLE": { "parameter": "/shared/certs/bundle.pem", "jsonKey": "pem" },
        "REPORTING_DB_PASSWORD": { "pointer": "orderbook/development/infra/reporting-db-arn", "jsonKey": "password" },
        "SMTP_PASSWORD": { "pionter": "/orderbook/development/infra/smtp-arn" }
      }
    },
    "production": {
      "secrets": {
        "DB_PASSWORD": { "pointer": "/orderbook/production/infra/db-secret-arn", "jsonKey": "password" }
      }
    }
  }
}
